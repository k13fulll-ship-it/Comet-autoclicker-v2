-- Comet (V6 - Final Edition: Draggable Multi-Square)
local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Parent = game:GetService("CoreGui")
ScreenGui.Name = "Comet_Draggable_V6"
ScreenGui.ResetOnSpawn = false

local VIM = game:GetService("VirtualInputManager")
local ClickTargets = {}
local IsAutoClicking = false

-- --- Interface Setup ---
local MainFrame = Instance.new("Frame")
MainFrame.Size = UDim2.new(0, 220, 0, 240)
MainFrame.Position = UDim2.new(0.5, -110, 0.5, -120)
MainFrame.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
MainFrame.Active = true
MainFrame.Draggable = true 
MainFrame.Parent = ScreenGui
Instance.new("UICorner", MainFrame)

local Title = Instance.new("TextLabel")
Title.Text = "Comet Multi-Drag"
Title.Size = UDim2.new(1, 0, 0, 40)
Title.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
Title.TextColor3 = Color3.fromRGB(255, 255, 255)
Title.Font = Enum.Font.GothamBold
Title.Parent = MainFrame

-- Helper to create buttons
local function createBtn(name, pos, color)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0, 190, 0, 40)
    btn.Position = pos
    btn.BackgroundColor3 = color
    btn.Text = name
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.Font = Enum.Font.GothamSemibold
    btn.Parent = MainFrame
    Instance.new("UICorner", btn)
    return btn
end

local b1 = createBtn("Add Square", UDim2.new(0, 15, 0, 55), Color3.fromRGB(45, 45, 45))
local b2 = createBtn("Start Clicking", UDim2.new(0, 15, 0, 105), Color3.fromRGB(0, 150, 0))
local b3 = createBtn("Clear All", UDim2.new(0, 15, 0, 155), Color3.fromRGB(150, 0, 0))

-- --- Functions ---

-- Spawns a draggable square
b1.MouseButton1Click:Connect(function()
    local NewSquare = Instance.new("Frame")
    NewSquare.Name = "ClickZone"
    NewSquare.Size = UDim2.new(0, 50, 0, 50)
    NewSquare.Position = UDim2.new(0.5, -25, 0.5, -25)
    NewSquare.BackgroundColor3 = Color3.fromHSV(math.random(), 0.6, 0.8)
    NewSquare.BackgroundTransparency = 0.4
    NewSquare.Active = true
    NewSquare.Draggable = true -- Standard drag enabled
    NewSquare.Parent = ScreenGui
    Instance.new("UICorner", NewSquare)
    
    local Label = Instance.new("TextLabel", NewSquare)
    Label.Size = UDim2.new(1, 0, 1, 0)
    Label.BackgroundTransparency = 1
    Label.Text = "DRAG ME"
    Label.TextSize = 10
    Label.TextColor3 = Color3.new(1, 1, 1)

    table.insert(ClickTargets, NewSquare)
end)

-- Clicking Logic
b2.MouseButton1Click:Connect(function()
    if #ClickTargets > 0 and not IsAutoClicking then
        IsAutoClicking = true
        b2.Text = "Clicking Active ✅"
        b2.BackgroundColor3 = Color3.fromRGB(0, 100, 0)
        
        task.spawn(function()
            while IsAutoClicking do
                for _, target in pairs(ClickTargets) do
                    if target and target.Parent then
                        -- We calculate center every loop so it follows the drag
                        local x = target.AbsolutePosition.X + (target.AbsoluteSize.X / 2)
                        local y = target.AbsolutePosition.Y + (target.AbsoluteSize.Y / 2)
                        
                        VIM:SendMouseButtonEvent(x, y, 0, true, game, 1)
                        VIM:SendMouseButtonEvent(x, y, 0, false, game, 1)
                    end
                end
                task.wait(0.05) -- Slight delay to keep it smooth while dragging
            end
        end)
    end
end)

-- Reset Logic
b3.MouseButton1Click:Connect(function()
    IsAutoClicking = false
    b2.Text = "Start Clicking"
    b2.BackgroundColor3 = Color3.fromRGB(0, 150, 0)
    for _, v in pairs(ClickTargets) do
        v:Destroy()
    end
    ClickTargets = {}
end)
